{
	"manifest_version": 3,
	"name": "Mambo Everywhere",
	"version": "1.1.0",
	"description": "Mambo. Proudly everywhere.",
	"permissions": ["storage"],
	"action": {
		"default_popup": "popup/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "assets/icon/Mambo-16.png",
		"32": "assets/icon/Mambo-32.png",
		"48": "assets/icon/Mambo-48.png",
		"128": "assets/icon/Mambo-128.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"assets/audio/mambo.mp3"
			],
			"matches": ["<all_urls>"]
		}
	]
}
